import json
import re
from collections import Counter
from pathlib import Path

BASE = Path.home() / "ShortAutoPro"
SID = "2026-09-01_1349"

script_path = (
    BASE
    / "roteiros"
    / f"short_{SID}.txt"
)

scene_path = (
    BASE
    / "roteiros"
    / f"scene_map_{SID}.json"
)

lossless_path = (
    BASE
    / "roteiros"
    / f"scene_lossless_{SID}.json"
)

if not all(
    p.exists()
    for p in (
        script_path,
        scene_path,
        lossless_path,
    )
):
    raise SystemExit(
        "OLD CASE FILES MISSING"
    )


def words(text):
    return re.findall(
        r"[A-Za-zÀ-ÿ0-9]+",
        str(text).lower()
    )


def find_scenes(obj):
    if isinstance(obj, list):
        if (
            len(obj) >= 3
            and all(
                isinstance(x, dict)
                for x in obj
            )
        ):
            if any(
                any(
                    k in x
                    for k in (
                        "trecho",
                        "text",
                        "texto",
                        "narration",
                        "script_text",
                        "scene_text",
                    )
                )
                for x in obj
            ):
                return obj

        for x in obj:
            r = find_scenes(x)
            if r:
                return r

    elif isinstance(obj, dict):
        for x in obj.values():
            r = find_scenes(x)
            if r:
                return r

    return []


def scene_text(scene):
    for key in (
        "trecho",
        "text",
        "texto",
        "narration",
        "script_text",
        "scene_text",
        "content",
    ):
        value = scene.get(key)

        if isinstance(value, str):
            return value

    return ""


script = script_path.read_text(
    encoding="utf-8"
)

scene_data = json.loads(
    scene_path.read_text(
        encoding="utf-8"
    )
)

lossless = json.loads(
    lossless_path.read_text(
        encoding="utf-8"
    )
)

scenes = find_scenes(
    scene_data
)

script_words = words(
    script
)

mapped_words = words(
    " ".join(
        scene_text(x)
        for x in scenes
    )
)

script_counter = Counter(
    script_words
)

mapped_counter = Counter(
    mapped_words
)

matched = sum(
    min(
        count,
        mapped_counter.get(
            word,
            0
        )
    )
    for word, count
    in script_counter.items()
)

coverage = (
    matched
    / max(
        len(script_words),
        1
    )
)

overflow = max(
    0,
    len(mapped_words)
    - matched
)

overflow_ratio = (
    overflow
    / max(
        len(script_words),
        1
    )
)

vocabulary = set(
    script_words
)

novel = [
    w
    for w in mapped_words
    if w not in vocabulary
]

novel_ratio = (
    len(novel)
    / max(
        len(script_words),
        1
    )
)

source_normalized = " ".join(
    script_words
)

sources_valid = True

for item in (
    lossless.get(
        "changed_scenes"
    )
    or []
):
    source_text = (
        item.get(
            "source_text"
        )
        or ""
    )

    normalized = " ".join(
        words(
            source_text
        )
    )

    if (
        not normalized
        or normalized
        not in source_normalized
    ):
        sources_valid = False


verified = (
    lossless.get("status") == "PASS"
    and not (
        lossless.get(
            "missing_after"
        )
        or []
    )
    and lossless.get(
        "coverage_after"
    ) == 1.0
    and sources_valid
    and len(novel) == 0
)


print(
    "SCRIPT WORDS:",
    len(script_words)
)

print(
    "SCENE WORDS:",
    len(mapped_words)
)

print(
    "COVERAGE:",
    round(
        coverage * 100,
        1
    ),
    "%"
)

print(
    "RAW OVERFLOW:",
    round(
        overflow_ratio * 100,
        1
    ),
    "%"
)

print(
    "TRUE NOVEL CONTENT:",
    round(
        novel_ratio * 100,
        1
    ),
    "%"
)

print(
    "NOVEL WORDS:",
    sorted(
        set(novel)
    )
)

print(
    "LOSSLESS VERIFIED:",
    verified
)


if coverage < .96:
    raise SystemExit(
        "OLD CASE COVERAGE FAILED"
    )

if novel_ratio > .08:
    raise SystemExit(
        "TRUE NOVEL CONTENT TOO HIGH"
    )

if not verified:
    raise SystemExit(
        "LOSSLESS VERIFICATION FAILED"
    )


print(
    "OLD CASE SEMANTIC CHECK=PASS"
)
